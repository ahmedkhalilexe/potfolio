---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiHero from '../components/AsciiHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import SkillsGrid from '../components/SkillsGrid.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout activePath="~" title="AMRANI ahmed khalil | Systems & Full Stack Engineer">
  <!-- 1. Hero Neofetch Dossier -->
  <AsciiHero />

  <!-- 2. Featured Projects / Architecture Case Studies -->
  <section id="projects" class="mb-12">
    <div class="flex flex-wrap items-center justify-between gap-2 border-b border-[var(--border-color)] pb-2 mb-6">
      <div class="flex items-center gap-2">
        <span class="text-[var(--accent-purple)] font-mono text-sm">▶</span>
        <h2 class="text-sm md:text-base font-mono font-bold uppercase tracking-wider text-[var(--accent-blue)]">
          Selected Systems & Case Studies
        </h2>
        <span class="text-xs font-mono text-[var(--text-dim)]">({sortedProjects.length} records)</span>
      </div>
      <a href="/projects" class="text-xs font-mono text-[var(--accent-cyan)] hover:underline flex items-center gap-1">
        <span>ls -la ./projects</span>
        <span>→</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sortedProjects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          tagline={project.data.tagline}
          role={project.data.role}
          status={project.data.status}
          tags={project.data.tags}
          metrics={project.data.metrics}
          architectureType={project.data.architectureType}
          featured={project.data.featured}
          github={project.data.github}
          liveUrl={project.data.liveUrl}
        />
      ))}
    </div>
  </section>

  <!-- 3. Career Experience (Inovask & ISO Voyage) -->
  <section id="experience" class="mb-12">
    <div class="flex items-center gap-2 border-b border-[var(--border-color)] pb-2 mb-6">
      <span class="text-[var(--accent-purple)] font-mono text-sm">▶</span>
      <h2 class="text-sm md:text-base font-mono font-bold uppercase tracking-wider text-[var(--accent-blue)]">
        Engineering Experience & Impact
      </h2>
    </div>

    <!-- Inovask -->
    <ExperienceCard
      role="Software Engineer"
      company="Inovask"
      period="Oct 2025 – Present"
      location="Remote"
      type="Full-time"
      achievements={[
        {
          category: "Testing & Reliability",
          description: "Raised tenant dashboard frontend test pass rate from ~50% to 100% by systematically fixing brittle test suites and extending Cypress end-to-end coverage.",
          metric: "Pass rate: 50% → 100%"
        },
        {
          category: "Architecture & Refactoring",
          description: "Cut technical debt by restructuring ~40% of the tenant dashboard codebase into a modular, pattern-consistent architecture with cookie and in-memory dual token authentication.",
          metric: "Debt cut: 40% codebase restructured"
        },
        {
          category: "CLI Tooling Ownership",
          description: "Owned end-to-end development of the platform's developer CLI tooling, implementing scaffolding commands, file synthesis, and Docker Compose orchestration.",
          metric: "Zero-drift containerized environments"
        },
        {
          category: "Generated Frontend Architecture",
          description: "Architected a two-phase rendering pipeline (load phase resolving schemas/tables/locales followed by React config-driven rendering) with zero hardcoded copy or markup.",
          metric: "Zero hardcoded UI copy"
        }
      ]}
      techStack={["Node.js", "React.js", "Docker", "Docker Compose", "Cypress", "TypeScript", "REST APIs"]}
    />

    <!-- ISO Voyage -->
    <ExperienceCard
      role="Full Stack Developer"
      company="ISO Voyage"
      period="Jun 2025 – Jan 2026"
      location="Remote"
      type="Freelance Contract"
      achievements={[
        {
          category: "Velocity Acceleration",
          description: "Accelerated feature delivery by 50% after joining 3 months into a contract, working across React/Next.js frontend and Express + Prisma backend.",
          metric: "+50% Feature velocity"
        },
        {
          category: "Codebase Modernization",
          description: "Eliminated legacy technical debt by rebuilding one of two frontend client applications from scratch and refactoring ~50% of the overall frontend codebase.",
          metric: "~50% Codebase rebuilt"
        },
        {
          category: "B2B Communication",
          description: "Engineered in-app and B2B communication flows, reducing user drop-offs and operational errors by ~30%.",
          metric: "~30% Drop-off reduction"
        },
        {
          category: "Cross-Functional Handover",
          description: "Coordinated with remote cross-functional teammates to deliver on-schedule handover with complete Docker setup and API documentation.",
        }
      ]}
      techStack={["React.js", "Next.js", "Node.js", "Express.js", "Prisma", "PostgreSQL", "Docker", "Redis", "Git"]}
    />
  </section>

  <!-- 4. Technical Skills Matrix -->
  <section id="skills" class="mb-12">
    <div class="flex items-center gap-2 border-b border-[var(--border-color)] pb-2 mb-6">
      <span class="text-[var(--accent-purple)] font-mono text-sm">▶</span>
      <h2 class="text-sm md:text-base font-mono font-bold uppercase tracking-wider text-[var(--accent-blue)]">
        Technical Proficiencies Matrix
      </h2>
    </div>

    <SkillsGrid />
  </section>

  <!-- 5. Terminal CLI Teaser / Quick Commands -->
  <section class="tui-box p-4 sm:p-5 bg-[var(--bg-surface)] border-[var(--border-active)]">
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-4 font-mono">
      <div class="min-w-0 flex-1">
        <div class="text-xs text-[var(--accent-cyan)] font-bold flex items-center gap-2">
          <span>⚡</span>
          <span>INTERACTIVE TERMINAL INTERPRETER</span>
        </div>
        <p class="text-xs text-[var(--text-muted)] mt-1.5 leading-relaxed">
          Type or press <kbd class="px-1.5 py-0.5 bg-[var(--bg-canvas)] border border-[var(--border-color)] text-[var(--accent-yellow)] text-[11px] font-bold">/</kbd> anywhere to open the live CLI shell. Try commands like <code class="text-[var(--accent-green)]">whoami</code>, <code class="text-[var(--accent-green)]">projects</code>, or <code class="text-[var(--accent-green)]">cat cv.txt</code>.
        </p>
      </div>

      <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full lg:w-auto shrink-0">
        <a href="/projects" class="tui-btn tui-btn-primary flex-1 sm:flex-initial justify-center text-center whitespace-nowrap">
          <span>Browse Case Studies</span>
          <span>→</span>
        </a>
        <a href="mailto:career.amraniahmedkhalil@gmail.com" class="tui-btn flex-1 sm:flex-initial justify-center text-center whitespace-nowrap">
          <span>Get In Touch</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
